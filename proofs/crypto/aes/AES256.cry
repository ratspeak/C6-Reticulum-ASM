// proofs/crypto/aes/AES256.cry
//
// Cryptol algorithmic specification for the AES-256 stack and CBC mode.
// Written from FIPS 197 first principles (S-box table form; the asm
// uses Boyar-Peralta's combinational circuit for constant-time, but
// both compute the same function — that equivalence is the burden of
// the angr Tier C verifier).
//
// This module is the source of truth for the entire crypto/aes module.
// Each per-function .saw driver imports it and proves the relevant
// KAT or algebraic property.

module AES256 where

// ---------- types ------------------------------------------------------

type Byte  = [8]
type Word  = [32]
type Block = [4][4]Byte    // 16 bytes laid out column-major per FIPS 197 §3.4
type Key256 = [32]Byte

// AES-256 has 14 rounds. Round-key schedule contains 60 words
// = 15 × (4 words per round-key) = 240 bytes.
type Nr = 14
type Nk = 8
type ScheduleWords = 60        // (Nr + 1) * 4 = 60
type ScheduleBytes = 240

// ---------- GF(2^8) primitives -----------------------------------------

// AES uses GF(2^8) with the irreducible polynomial 0x11B.
// xtime = multiplication by x (i.e., shift left, conditionally XOR 0x1B).
xtime : Byte -> Byte
xtime b = if (b && 0x80) != 0 then (b << 1) ^ 0x1b else (b << 1)

// Multiplication by 2, 4, 8 (for InvMixColumns).
mul2 : Byte -> Byte
mul2 = xtime

mul4 : Byte -> Byte
mul4 b = xtime (xtime b)

mul8 : Byte -> Byte
mul8 b = xtime (xtime (xtime b))

mul9 : Byte -> Byte
mul9 b = b ^ mul8 b

mulb : Byte -> Byte
mulb b = b ^ mul2 b ^ mul8 b   // 11

muld : Byte -> Byte
muld b = b ^ mul4 b ^ mul8 b   // 13

mule : Byte -> Byte
mule b = mul2 b ^ mul4 b ^ mul8 b  // 14

// ---------- FIPS 197 §5.1.1 S-box and Inverse S-box --------------------

sbox : [256]Byte
sbox =
