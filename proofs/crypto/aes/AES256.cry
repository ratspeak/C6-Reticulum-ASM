// ---------- per-byte S-box / inverse S-box ----------------------------

sub_byte : Byte -> Byte
sub_byte b = sbox @ b

inv_sub_byte : Byte -> Byte
inv_sub_byte b = inv_sbox @ b

// ---------- block layout ----------------------------------------------

// FIPS 197 §3.4: state is a 4×4 byte matrix, addressed column-major.
// Bytes 0..15 in memory occupy state[col][row]:
//   byte i → state[i / 4][i % 4]
bytes_to_state : [16]Byte -> Block
bytes_to_state bs = split bs

state_to_bytes : Block -> [16]Byte
state_to_bytes st = join st

// ---------- AES round transforms --------------------------------------

// SubBytes: apply S-box per byte.
sub_bytes : Block -> Block
sub_bytes st = [ [ sub_byte b | b <- col ] | col <- st ]

inv_sub_bytes : Block -> Block
inv_sub_bytes st = [ [ inv_sub_byte b | b <- col ] | col <- st ]

// AddRoundKey: XOR the round key into the state.
add_round_key : Block -> Block -> Block
add_round_key st rk = [ [ a ^ b | a <- ca | b <- cb ] | ca <- st | cb <- rk ]

// ShiftRows: each row r is rotated left by r positions.
//   new_state[col][row] = old_state[(col + row) mod 4][row]
shift_rows : Block -> Block
shift_rows st =
    [ [ st @ (((c + r) % 4) : [3]) @ (r : [3])
      | r <- [0..3] : [4][3]
      ]
    | c <- [0..3] : [4][3]
    ]

inv_shift_rows : Block -> Block
inv_shift_rows st =
    [ [ st @ (((c + 4 - r) % 4) : [3]) @ (r : [3])
      | r <- [0..3] : [4][3]
      ]
    | c <- [0..3] : [4][3]
    ]

// MixColumns: column-wise multiplication by the AES MDS matrix.
//
//   new_col[0] = 2*c0 ^ 3*c1 ^   c2 ^   c3
//   new_col[1] =   c0 ^ 2*c1 ^ 3*c2 ^   c3
//   new_col[2] =   c0 ^   c1 ^ 2*c2 ^ 3*c3
//   new_col[3] = 3*c0 ^   c1 ^   c2 ^ 2*c3
mix_one : [4]Byte -> [4]Byte
mix_one [c0, c1, c2, c3] =
    [ mul2 c0 ^ (c1 ^ mul2 c1) ^ c2 ^ c3
    , c0 ^ mul2 c1 ^ (c2 ^ mul2 c2) ^ c3
    , c0 ^ c1 ^ mul2 c2 ^ (c3 ^ mul2 c3)
    , (c0 ^ mul2 c0) ^ c1 ^ c2 ^ mul2 c3
    ]

mix_columns : Block -> Block
mix_columns st = map mix_one st

// InvMixColumns: column-wise multiplication by the inverse MDS matrix.
//   new_col[0] = 14*c0 ^ 11*c1 ^ 13*c2 ^  9*c3
//   new_col[1] =  9*c0 ^ 14*c1 ^ 11*c2 ^ 13*c3
//   new_col[2] = 13*c0 ^  9*c1 ^ 14*c2 ^ 11*c3
//   new_col[3] = 11*c0 ^ 13*c1 ^  9*c2 ^ 14*c3
inv_mix_one : [4]Byte -> [4]Byte
inv_mix_one [c0, c1, c2, c3] =
    [ mule c0 ^ mulb c1 ^ muld c2 ^ mul9 c3
    , mul9 c0 ^ mule c1 ^ mulb c2 ^ muld c3
    , muld c0 ^ mul9 c1 ^ mule c2 ^ mulb c3
    , mulb c0 ^ muld c1 ^ mul9 c2 ^ mule c3
    ]

inv_mix_columns : Block -> Block
inv_mix_columns st = map inv_mix_one st

// ---------- Key schedule ---------------------------------------------

// SubWord: apply S-box to each byte of a 4-byte word.
sub_word : [4]Byte -> [4]Byte
sub_word w = [ sub_byte b | b <- w ]

// RotWord: cyclic rotation by 1 byte (i.e., [b0, b1, b2, b3] -> [b1, b2, b3, b0]).
rot_word : [4]Byte -> [4]Byte
rot_word [a, b, c, d] = [b, c, d, a]

// Round constants. Rcon[i] = (xtime^(i-1)(0x01), 0, 0, 0). We index from 1.
rcon : [11][4]Byte
rcon = [ [r, 0, 0, 0] | r <- [ 0x00,  // unused index 0
                               0x01, 0x02, 0x04, 0x08, 0x10,
                               0x20, 0x40, 0x80, 0x1b, 0x36 ] ]

// AES-256 key expansion produces 60 4-byte words.
expand_words : Key256 -> [60][4]Byte
expand_words k = ws
  where
    initial : [8][4]Byte
    initial = split k

    ws : [60][4]Byte
    ws = initial # [ if (i % 8) == 0
                      then (ws @ (i - 8))
                         ^ (sub_word (rot_word (ws @ (i - 1))))
                         ^ (rcon @ (i / 8))
                      else if (i % 8) == 4
                      then (ws @ (i - 8))
                         ^ (sub_word (ws @ (i - 1)))
                      else (ws @ (i - 8))
                         ^ (ws @ (i - 1))
                   | i <- [8..59] : [52][8]
                   ]

// Expanded key as a flat 240-byte sequence (matching the asm's
// aes256_round_keys[] layout).
expand_bytes : Key256 -> [240]Byte
expand_bytes k = join (expand_words k)

// Round-keys as 15 blocks (one per round; [Nr+1] = 15).
expand_blocks : Key256 -> [15]Block
expand_blocks k = [ split (join chunk) | chunk <- (split (expand_words k) : [15][4][4]Byte) ]

// ---------- Cipher (encrypt block) -----------------------------------

// One "full" round: SubBytes -> ShiftRows -> MixColumns -> AddRoundKey.
encrypt_round : Block -> Block -> Block
encrypt_round st rk = add_round_key (mix_columns (shift_rows (sub_bytes st))) rk

// Final round (no MixColumns).
encrypt_final_round : Block -> Block -> Block
encrypt_final_round st rk = add_round_key (shift_rows (sub_bytes st)) rk

encrypt_block : Key256 -> Block -> Block
encrypt_block k pt = encrypt_final_round (states @ 13) (round_keys @ 14)
  where
    round_keys : [15]Block
    round_keys = expand_blocks k

    initial : Block
    initial = add_round_key pt (round_keys @ 0)

    states : [14]Block
    states = [ if i == 0 then initial
               else encrypt_round (states @ (i - 1)) (round_keys @ i)
             | i <- [0..13] : [14][4]
             ]

// One "full" inverse round: InvShiftRows -> InvSubBytes -> AddRoundKey -> InvMixColumns.
decrypt_round : Block -> Block -> Block
decrypt_round st rk = inv_mix_columns (add_round_key (inv_sub_bytes (inv_shift_rows st)) rk)

decrypt_final_round : Block -> Block -> Block
decrypt_final_round st rk = add_round_key (inv_sub_bytes (inv_shift_rows st)) rk

decrypt_block : Key256 -> Block -> Block
decrypt_block k ct = decrypt_final_round (states @ 13) (round_keys @ 0)
  where
    round_keys : [15]Block
    round_keys = expand_blocks k

    initial : Block
    initial = add_round_key ct (round_keys @ 14)

    states : [14]Block
    states = [ if i == 0 then initial
               else decrypt_round (states @ (i - 1)) (round_keys @ (14 - i))
             | i <- [0..13] : [14][4]
             ]

// ---------- CBC mode --------------------------------------------------

xor_blocks : Block -> Block -> Block
xor_blocks a b = [ [ x ^ y | x <- ca | y <- cb ] | ca <- a | cb <- b ]

cbc_encrypt : {n} (fin n, n >= 1, n <= 256) =>
                Key256 -> [16]Byte -> [n]Block -> [n]Block
cbc_encrypt k iv blocks = cts
  where
    cts : [n]Block
    cts = [ if i == 0
            then encrypt_block k (xor_blocks (bytes_to_state iv) (blocks @ 0))
            else encrypt_block k (xor_blocks (cts @ (i - 1)) (blocks @ i))
          | i <- [0..n - 1] : [n][8]
          ]

cbc_decrypt : {n} (fin n, n >= 1, n <= 256) =>
                Key256 -> [16]Byte -> [n]Block -> [n]Block
cbc_decrypt k iv cts = pts
  where
    pts : [n]Block
    pts = [ if i == 0
            then xor_blocks (bytes_to_state iv) (decrypt_block k (cts @ 0))
            else xor_blocks (cts @ (i - 1))     (decrypt_block k (cts @ i))
          | i <- [0..n - 1] : [n][8]
          ]

// ---------- KAT vectors ----------------------------------------------

// FIPS 197 §B example: SubBytes(0x53) = 0xed.
sbox_53_kat = sub_byte 0x53 == 0xed

// FIPS 197 §A.3: AES-256 key expansion test key.
fips_a3_key : Key256
fips_a3_key =
    [ 0x60, 0x3d, 0xeb, 0x10, 0x15, 0xca, 0x71, 0xbe
    , 0x2b, 0x73, 0xae, 0xf0, 0x85, 0x7d, 0x77, 0x81
    , 0x1f, 0x35, 0x2c, 0x07, 0x3b, 0x61, 0x08, 0xd7
    , 0x2d, 0x98, 0x10, 0xa3, 0x09, 0x14, 0xdf, 0xf4
    ]

// FIPS 197 §A.3 expected w[0..7] (the input key as words).
fips_a3_w0_w7 : [8][4]Byte
fips_a3_w0_w7 =
    [ [0x60, 0x3d, 0xeb, 0x10], [0x15, 0xca, 0x71, 0xbe]
    , [0x2b, 0x73, 0xae, 0xf0], [0x85, 0x7d, 0x77, 0x81]
    , [0x1f, 0x35, 0x2c, 0x07], [0x3b, 0x61, 0x08, 0xd7]
    , [0x2d, 0x98, 0x10, 0xa3], [0x09, 0x14, 0xdf, 0xf4]
    ]

// FIPS 197 §A.3 expected w[8] (first computed word).
fips_a3_w8 : [4]Byte
fips_a3_w8 = [0x9b, 0xa3, 0x54, 0x11]

// FIPS 197 §A.3 expected w[59] (last word in the schedule = round-14 word 3).
fips_a3_w59 : [4]Byte
fips_a3_w59 = [0x70, 0x6c, 0x63, 0x1e]

// FIPS 197 §A.3 expected w[56] (first word of round 14).
fips_a3_w56 : [4]Byte
fips_a3_w56 = [0xfe, 0x48, 0x90, 0xd1]

key_expand_w8_kat  = (expand_words fips_a3_key) @ 8 == fips_a3_w8
key_expand_w56_kat = (expand_words fips_a3_key) @ 56 == fips_a3_w56
key_expand_w59_kat = (expand_words fips_a3_key) @ 59 == fips_a3_w59
key_expand_input_preserved =
    take`{8} (expand_words fips_a3_key) == fips_a3_w0_w7

// FIPS 197 §C.3: AES-256 encrypt block test vector.
fips_c3_pt : [16]Byte
fips_c3_pt =
    [ 0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77
    , 0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff
    ]

fips_c3_key : Key256
fips_c3_key =
    [ 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07
    , 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f
    , 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17
    , 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f
    ]

fips_c3_ct : [16]Byte
fips_c3_ct =
    [ 0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf
    , 0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89
    ]

encrypt_c3_kat : Bit
encrypt_c3_kat = state_to_bytes (encrypt_block fips_c3_key (bytes_to_state fips_c3_pt)) == fips_c3_ct

decrypt_c3_kat : Bit
decrypt_c3_kat = state_to_bytes (decrypt_block fips_c3_key (bytes_to_state fips_c3_ct)) == fips_c3_pt

// Round-trip: enc then dec over arbitrary input ≡ identity.
roundtrip : Key256 -> Block -> Bit
roundtrip k pt = decrypt_block k (encrypt_block k pt) == pt

// ---------- algebraic sanity -----------------------------------------

// SubBytes is the inverse of InvSubBytes for any byte.
sub_invsub_inverse : Byte -> Bit
sub_invsub_inverse b = inv_sub_byte (sub_byte b) == b

invsub_sub_inverse : Byte -> Bit
invsub_sub_inverse b = sub_byte (inv_sub_byte b) == b

// MixColumns is the inverse of InvMixColumns for any column.
mix_invmix_inverse : [4]Byte -> Bit
mix_invmix_inverse col = inv_mix_one (mix_one col) == col

invmix_mix_inverse : [4]Byte -> Bit
invmix_mix_inverse col = mix_one (inv_mix_one col) == col

// xtime spot checks.
xtime_zero = xtime 0 == 0
xtime_one  = xtime 1 == 0x02
xtime_msb_set = xtime 0x80 == 0x1b   // wraps to the irreducible poly
