# Binsec/Rel constant-time check for aes_subbytes (Tier B per ADR-0009).
#
# aes_subbytes applies aes_sbox to each of the 16 state bytes via a
# fixed-count loop (cursor advances from base to base+16). The loop
# counter is structural — not data-dependent — and aes_sbox is itself
# constant-time (separately proven by aes_sbox.bsc). This proof covers
# the wrapper loop + the 16 calls into aes_sbox, treating the 16
# state bytes as secret.
#
# Threat model: state[0..16] is secret (an AES round's intermediate
# state, derived from the secret key + plaintext). a0 (state pointer)
# is public. sp/ra are public.

starting from <aes_subbytes> with
  sp := 0x90000000
  ra := 0xDEADBEEF
  a0 := 0x80000000          # state buffer base — concrete public addr
  @[a0,  1] := secret as state_byte_0
  @[a0 + 1,  1] := secret as state_byte_1
  @[a0 + 2,  1] := secret as state_byte_2
  @[a0 + 3,  1] := secret as state_byte_3
  @[a0 + 4,  1] := secret as state_byte_4
  @[a0 + 5,  1] := secret as state_byte_5
  @[a0 + 6,  1] := secret as state_byte_6
  @[a0 + 7,  1] := secret as state_byte_7
  @[a0 + 8,  1] := secret as state_byte_8
  @[a0 + 9,  1] := secret as state_byte_9
  @[a0 + 10, 1] := secret as state_byte_10
  @[a0 + 11, 1] := secret as state_byte_11
  @[a0 + 12, 1] := secret as state_byte_12
  @[a0 + 13, 1] := secret as state_byte_13
  @[a0 + 14, 1] := secret as state_byte_14
  @[a0 + 15, 1] := secret as state_byte_15
end

halt at <aes_subbytes> return

explore all
