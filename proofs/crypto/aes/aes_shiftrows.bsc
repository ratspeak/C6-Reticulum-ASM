# Binsec/Rel constant-time check for aes_shiftrows (Tier B per ADR-0009).
#
# aes_shiftrows permutes the 16-byte state per FIPS 197 §5.1.2 — pure
# byte-level rearrangement at fixed offsets, no branches, no
# data-dependent addressing. Secret is the state buffer.

starting from <aes_shiftrows> with
  sp := 0x90000000
  ra := 0xDEADBEEF
  a0 := 0x80000000          # state buffer
  @[a0,  4] := secret as state_w0
  @[a0 + 4, 4] := secret as state_w1
  @[a0 + 8, 4] := secret as state_w2
  @[a0 + 12, 4] := secret as state_w3
end

halt at <aes_shiftrows> return

explore all
