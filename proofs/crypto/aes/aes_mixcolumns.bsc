# Binsec/Rel constant-time check for aes_mixcolumns (Tier B per ADR-0009).
#
# aes_mixcolumns applies the FIPS 197 §5.1.3 MixColumns matrix
# multiplication to each of the 4 columns of the state. The xtime
# multiplication is implemented branch-free (mask-and-XOR per the
# .S preamble), so the whole function is constant-time by
# construction. Secret is the state buffer.

starting from <aes_mixcolumns> with
  sp := 0x90000000
  ra := 0xDEADBEEF
  a0 := 0x80000000
  @[a0,  4] := secret as state_w0
  @[a0 + 4, 4] := secret as state_w1
  @[a0 + 8, 4] := secret as state_w2
  @[a0 + 12, 4] := secret as state_w3
end

halt at <aes_mixcolumns> return

explore all
