# Binsec/Rel constant-time check for aes_addroundkey (Tier B per ADR-0009).
#
# aes_addroundkey is XOR over two 16-byte buffers — branch-free, no
# data-dependent indexing, fixed-offset word-aligned loads/stores.
# Both inputs are secret in AES (the state is the running cipher
# block, the round_key is derived from the secret master key).

starting from <aes_addroundkey> with
  sp := 0x90000000
  ra := 0xDEADBEEF
  a0 := 0x80000000          # state buffer
  a1 := 0x80001000          # round_key buffer
  @[a0,  4] := secret as state_w0
  @[a0 + 4, 4] := secret as state_w1
  @[a0 + 8, 4] := secret as state_w2
  @[a0 + 12, 4] := secret as state_w3
  @[a1,  4] := secret as rkey_w0
  @[a1 + 4, 4] := secret as rkey_w1
  @[a1 + 8, 4] := secret as rkey_w2
  @[a1 + 12, 4] := secret as rkey_w3
end

halt at <aes_addroundkey> return

explore all
