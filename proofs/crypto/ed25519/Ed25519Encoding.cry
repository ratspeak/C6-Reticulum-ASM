// proofs/crypto/ed25519/Ed25519Encoding.cry
//
// Cryptol algorithmic specification for the Ed25519 high-level
// operations on top of point arithmetic:
//
//   * field_pow_p5d8    : a^((p - 5) / 8) mod p — the exponent used in
//                         the field square-root step of point decoding
//                         (RFC 8032 §5.1.3).
//   * point_compress    : (X, Y, Z, T) -> 32-byte encoding (RFC 8032
//                         §5.1.2: y as 255-bit LE, top bit = sign of x).
//   * point_decompress  : 32-byte encoding -> Maybe Point (Result type
//                         simulating the asm's 0/1 return code).
//   * scalarmult        : n × P via double-and-add over the BBJLP
//                         formulas. The asm runs constant-time, with
//                         identity (0, 1, 1, 0) as the running result.
//
// The asm implementations live in radix-2^25.5 limb form; this module
// collapses field arithmetic to Integer-mod-p so SAW can discharge
// concrete KATs against the abstract spec without running the limb
// machinery.

module Ed25519Encoding where

import X25519
import Ed25519Point

// ---------- field_pow_p5d8 -------------------------------------------

// (p - 5) / 8 = (2^255 - 19 - 5) / 8 = (2^255 - 24) / 8 = 2^252 - 3.
//
// In Ed25519's RFC 8032 §5.1.3 decoding, this exponent is part of the
// candidate-x formula:  cand = u * v^3 * (u * v^7)^((p-5)/8).
p5d8_exponent : Integer
p5d8_exponent = (p_25519 - 5) / 8

// a^((p-5)/8) mod p.
field_pow_p5d8 : Integer -> Integer
field_pow_p5d8 a = f_pow a p5d8_exponent

// ---------- point_compress ------------------------------------------

// Convert affine (x, y) to the 32-byte encoding: y as little-endian
// 255-bit integer with the sign-of-x bit at the top.
encode_affine : Integer -> Integer -> [32][8]
encode_affine x y = bytes_with_sign
  where
    y_bytes = encode_le y
    sign_bit = fromInteger (x % 2) : [8]
    // OR the sign bit into bit 7 of byte 31.
    last_byte = (y_bytes @ 31) || (sign_bit << 7)
    bytes_with_sign = (take`{31} y_bytes) # [last_byte]

// point_compress(P): convert extended-coords P to its 32-byte encoding.
point_compress : Point -> [32][8]
point_compress P = encode_affine (affine_x P) (affine_y P)

// ---------- point_decompress ----------------------------------------

// sqrt(-1) mod p — the single non-trivial element of order 4 in F_p^*.
// Used in the candidate-fix-up step when v * cand^2 == -u.
//
//   sqrt_m1 = 2^((p-1)/4) mod p
sqrt_m1 : Integer
sqrt_m1 = f_pow 2 ((p_25519 - 1) / 4)

// Recover x from y given the sign bit, per RFC 8032 §5.1.3:
//
//   u = y^2 - 1; v = d * y^2 + 1
//   cand = u * v^3 * (u * v^7)^((p-5)/8)
//   if v * cand^2 == u then x = cand
//   elif v * cand^2 == -u then x = cand * sqrt(-1)
//   else fail (no square root)
//
// Then fix sign: if (x mod 2) != sign, x = -x.
//
// Returns (success, x) where success is 0 (valid) or 1 (invalid), to
// mirror the asm's a0 return convention.
recover_x : Integer -> Bit -> (Bit, Integer)
recover_x y sign = (status, x_signed)
  where
    y2 = f_sq y
    u  = f_sub y2 1
    v  = f_add (f_mul d_int y2) 1
    v3 = f_mul (f_sq v) v
    v7 = f_mul v3 (f_mul v3 v)
    uv7 = f_mul u v7
    pow = field_pow_p5d8 uv7
    cand = f_mul u (f_mul v3 pow)
    vxx = f_mul v (f_sq cand)
    matches_u   = vxx == u
    matches_neg = vxx == (f_sub 0 u)
    invalid     = ~ (matches_u \/ matches_neg)
    cand_fixed  = if matches_u then cand else f_mul cand sqrt_m1
    sign_int    = if sign then 1 else 0
    needs_neg   = (cand_fixed % 2) != sign_int
    x_signed    = if needs_neg then f_sub 0 cand_fixed else cand_fixed
    status      = invalid

// ---------- scalarmult (specification, not the constant-time asm) ----

// scalarmult(n, P) = n × P, computed via the high-bit-first
// double-and-add algorithm. Returns (X, Y, Z, T) extended coords.
//
// We unfold a fixed 256-bit scalar as a [256]Bit (LSB first to match
// the asm's byte-by-byte LE scan). The Cryptol model uses the
// dedicated point_add/point_double from Ed25519Point.
//
// For SAW-tractable proofs, we provide a small `scalarmult_fixed_n`
// helper that takes n as an Integer and unfolds it into the
// appropriate bit pattern.

// Fold a list of bits MSB-first: identity, then for each bit double
// the accumulator and conditionally add P.
scalarmult_bits : [256]Bit -> Point -> Point
scalarmult_bits bits P = (acc ! 0)
  where
    acc : [257]Point
    acc = [identity] # [ if b then point_add (point_double a) P
                              else point_double a
                       | a <- acc
                       | b <- bits
                       ]

// Convert an Integer in [0, 2^256) to its MSB-first bit list.
int_to_bits_msb : Integer -> [256]Bit
int_to_bits_msb n = [ ((n / (2 ^^ i)) % 2) == 1
                    | i <- [255, 254 .. 0] : [256]Integer
                    ]

scalarmult : Integer -> Point -> Point
scalarmult n P = scalarmult_bits (int_to_bits_msb n) P

// ---------- KATs ----------------------------------------------------

// Small affine encoding sanity. Identity point (X=0, Y=1, Z=1, T=0)
// has affine x = 0, y = 1, so the encoding is [0x01, 0x00, ..., 0x00]
// (the LSB of x is 0, so the sign bit is 0).
identity_compress_kat : Bit
identity_compress_kat =
    point_compress identity == ([0x01] # (zero : [31][8]))

// The base point B's encoding (RFC 8032 §5.1, IETF Test Vectors).
//
//   pk = compress(B) = 5866666666666666666666666666666666666666666666666666666666666666 (hex)
B_encoded : [32][8]
B_encoded =
    [ 0x58, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66
    , 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66
    , 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66
    , 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66
    ]

base_compress_kat : Bit
base_compress_kat = point_compress B == B_encoded

// scalarmult(0, B) == identity.
scalarmult_zero_kat : Bit
scalarmult_zero_kat = point_eq (scalarmult 0 B) identity

// scalarmult(1, B) == B.
scalarmult_one_kat : Bit
scalarmult_one_kat = point_eq (scalarmult 1 B) B

// scalarmult(2, B) == double(B).
scalarmult_two_kat : Bit
scalarmult_two_kat = point_eq (scalarmult 2 B) (point_double B)

// scalarmult(3, B) == double(B) + B.
scalarmult_three_kat : Bit
scalarmult_three_kat = point_eq (scalarmult 3 B) (point_add (point_double B) B)

// Round trip: decompress(B_encoded) recovers B (status = false = valid).
//
// The recover_x answer is the affine x; we then construct the extended
// coords and check for affine equality with the literal B.
decompress_B_x : Integer
decompress_B_x = (recover_x B_y (B_x % 2 == 1)).1

decompress_B_status : Bit
decompress_B_status = (recover_x B_y (B_x % 2 == 1)).0

decompress_base_kat : Bit
decompress_base_kat = ~decompress_B_status /\ decompress_B_x == B_x

// field_pow_p5d8 KAT: 1^((p-5)/8) == 1.
field_pow_p5d8_kat_one : Bit
field_pow_p5d8_kat_one = field_pow_p5d8 1 == 1

// field_pow_p5d8 KAT: 0^((p-5)/8) == 0.
field_pow_p5d8_kat_zero : Bit
field_pow_p5d8_kat_zero = field_pow_p5d8 0 == 0

// sqrt_m1 squared == -1 (mod p).
sqrt_m1_squared_kat : Bit
sqrt_m1_squared_kat = f_sq sqrt_m1 == f_sub 0 1
