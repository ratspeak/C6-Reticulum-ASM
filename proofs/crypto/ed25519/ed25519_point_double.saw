// proofs/crypto/ed25519/ed25519_point_double.saw
//
// SAW driver for ed25519_point_double algorithmic verification (Tier A
// per ADR-0009): proves the Cryptol model in Ed25519Point.cry
// implements the BBJLP 2008 doubling law correctly on edwards25519.
//
// The asm executes the same 4 sq + 3 mul + 5 add/sub formula in
// radix-2^25.5 limb form using x25519_field_{add,sub,mul,sq};
// correctness flows from algebraic identities at the integer-mod-p
// level (this module) plus the per-field-op proofs in
// proofs/crypto/x25519/. The QEMU pytest at
// tests/crypto/ed25519/test_ed25519_point_double.py pins down the
// asm-vs-Python observable equivalence on RFC-derived inputs.
//
// The headline algebraic property: point_double(P) ==
// point_add(P, P) (the BBJLP add formula is *complete* on
// edwards25519, so it remains valid for equal inputs — this is what
// makes constant-time scalarmult possible without a separate doubling
// case).
//
// Run standalone:
//   saw proofs/crypto/ed25519/ed25519_point_double.saw
// or via dispatcher:
//   ./verify ed25519_point_double

import "Ed25519Point.cry";

print "[ed25519_point_double.saw] proving point_double(B) == point_add(B, B) ...";
prove_print z3 {{ double_eq_add }};
print "[ed25519_point_double.saw] doubling matches dedicated add at equal inputs: PASS.";

print "[ed25519_point_double.saw] proving point_double(identity) == identity ...";
prove_print z3 {{ double_identity_is_identity }};
print "[ed25519_point_double.saw] doubling preserves identity: PASS.";

print "[ed25519_point_double.saw] PASS";
