// proofs/crypto/ed25519/ed25519_point_compress.saw
//
// SAW driver for ed25519_point_compress algorithmic verification
// (Tier A per ADR-0009): proves the Cryptol model in
// Ed25519Encoding.cry encodes points per RFC 8032 §5.1.2 — y as a
// 255-bit LE integer with the sign-of-x bit installed at bit 7 of
// byte 31.
//
// The asm computes Z_inv via field_inv, multiplies into x and y,
// packs y, then ORs (x_LSB << 7) into byte 31. The Cryptol model
// collapses all that to integer arithmetic + the same byte-level OR.
// SAW verifies the canonical identity encoding ([0x01, 0, ..., 0])
// and the canonical base-point encoding (RFC 8032 §5.1 / IETF Test
// Vectors). The QEMU pytest at tests/crypto/ed25519/test_ed25519_sign.py
// pins down the asm-vs-Python observable equivalence transitively
// (every signature emits a compressed R as its first 32 bytes).
//
// Run standalone:
//   saw proofs/crypto/ed25519/ed25519_point_compress.saw
// or via dispatcher:
//   ./verify ed25519_point_compress

import "Ed25519Encoding.cry";

print "[ed25519_point_compress.saw] proving compress(identity) == [0x01, 0, ..., 0] ...";
prove_print z3 {{ identity_compress_kat }};
print "[ed25519_point_compress.saw] identity encoding: PASS.";

print "[ed25519_point_compress.saw] proving compress(B) == published RFC 8032 base-point encoding ...";
prove_print z3 {{ base_compress_kat }};
print "[ed25519_point_compress.saw] base point encoding: PASS.";

print "[ed25519_point_compress.saw] PASS";
