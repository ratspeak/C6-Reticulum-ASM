# Binsec/Rel constant-time check for x25519_field_pack (Tier B per ADR-0009).
#
# x25519_field_pack contracts 10 radix-2^25.5 limbs into a canonical
# 32-byte little-endian field encoding. The input limbs may be secret during
# X25519 scalar multiplication. The function performs fixed carry rounds,
# a constant-time conditional subtraction of p, and fixed-offset byte stores;
# output bytes may depend on the secret limbs, but control flow and memory
# access addresses must not.

starting from <x25519_field_pack> with
  sp := 0x90000000
  ra := 0xDEADBEEF
  a0 := 0x80000000          # out bytes (32 bytes)
  a1 := 0x80001000          # input limbs (40 bytes)
  for i<32> in 0 to 9 do
    @[a1 + i * 4, 4] := secret as input_limb
  end
end

halt at <x25519_field_pack> return

explore all
