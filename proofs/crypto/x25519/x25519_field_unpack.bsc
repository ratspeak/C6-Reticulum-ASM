# Binsec/Rel constant-time check for x25519_field_unpack (Tier B per ADR-0009).
#
# x25519_field_unpack expands a 32-byte little-endian field encoding into
# 10 radix-2^25.5 limbs. The encoded bytes may be secret when unpacking
# intermediate field data, so this proof marks all input bytes secret and
# checks that the compiled RV32IMC body uses only fixed-offset loads/stores
# and straight-line bit slicing.

starting from <x25519_field_unpack> with
  sp := 0x90000000
  ra := 0xDEADBEEF
  a0 := 0x80000000          # out limbs (40 bytes)
  a1 := 0x80001000          # input bytes (32 bytes)
  for i<32> in 0 to 31 do
    @[a1 + i, 1] := secret as input_byte
  end
end

halt at <x25519_field_unpack> return

explore all
