# Binsec/Rel constant-time check for x25519_field_inv (Tier B per ADR-0009).
#
# x25519_field_inv computes a^(p_25519 - 2) with the fixed curve25519-donna
# addition chain. The exponent is public and the chain is a statically unrolled
# sequence of x25519_field_sq and x25519_field_mul calls over stack-local
# temporaries. The input field element and all derived temporaries are secret;
# output values may depend on them, but control flow and memory-access
# addresses must not.

starting from <x25519_field_inv> with
  sp := 0x90000000
  ra := 0xDEADBEEF
  a0 := 0x80000000          # out (40 bytes)
  a1 := 0x80001000          # a   (40 bytes)
  for i<32> in 0 to 9 do
    @[a1 + i * 4, 4] := secret as a_limb
  end
end

halt at <x25519_field_inv> return

explore all
