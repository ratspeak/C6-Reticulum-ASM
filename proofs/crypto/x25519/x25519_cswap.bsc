# Binsec/Rel constant-time check for x25519_cswap (Tier B per ADR-0009).
#
# x25519_cswap is the canonical constant-time conditional swap from
# RFC 7748 §5: mask = -swap (0 → 0x00000000, 1 → 0xFFFFFFFF) feeds
# 10 unrolled XOR-and-XOR cycles with no branch on swap. The Tier B
# obligation is to confirm against the compiled binary that:
#   * No branch depends on `swap` (a0).
#   * No memory access pattern depends on `swap`.
# The two 40-byte field-element limbs (a, b) are also secret (Montgomery
# ladder state during a private-key scalar multiplication).

starting from <x25519_cswap> with
  sp := 0x90000000
  ra := 0xDEADBEEF
  a0 := secret as swap_bit
  assume a0 < 2
  a1 := 0x80000000          # &a (40 bytes)
  a2 := 0x80001000          # &b (40 bytes)
  @[a1,  4]  := secret as a_limb_0
  @[a1 + 4,  4]  := secret as a_limb_1
  @[a1 + 8,  4]  := secret as a_limb_2
  @[a1 + 12, 4]  := secret as a_limb_3
  @[a1 + 16, 4]  := secret as a_limb_4
  @[a1 + 20, 4]  := secret as a_limb_5
  @[a1 + 24, 4]  := secret as a_limb_6
  @[a1 + 28, 4]  := secret as a_limb_7
  @[a1 + 32, 4]  := secret as a_limb_8
  @[a1 + 36, 4]  := secret as a_limb_9
  @[a2,  4]  := secret as b_limb_0
  @[a2 + 4,  4]  := secret as b_limb_1
  @[a2 + 8,  4]  := secret as b_limb_2
  @[a2 + 12, 4]  := secret as b_limb_3
  @[a2 + 16, 4]  := secret as b_limb_4
  @[a2 + 20, 4]  := secret as b_limb_5
  @[a2 + 24, 4]  := secret as b_limb_6
  @[a2 + 28, 4]  := secret as b_limb_7
  @[a2 + 32, 4]  := secret as b_limb_8
  @[a2 + 36, 4]  := secret as b_limb_9
end

halt at <x25519_cswap> return

explore all
