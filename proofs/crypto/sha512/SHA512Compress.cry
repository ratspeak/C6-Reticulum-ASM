// proofs/crypto/sha512/SHA512Compress.cry
//
// Cryptol algorithmic specification for sha512_compress.
//
// FIPS 180-4 §6.4.2 specifies the SHA-512 compression function as an
// 80-round transformation that updates an 8-word hash state H using a
// 16-word message block M, where each word is 64 bits. This module
// formalises the spec from first principles and supplies KAT
// properties that SAW discharges.
//
// Differences from SHA-256:
//   * 64-bit words instead of 32-bit
//   * 80 rounds instead of 64
//   * Sigma_0(x) = ROTR(x,28) ^ ROTR(x,34) ^ ROTR(x,39)
//   * Sigma_1(x) = ROTR(x,14) ^ ROTR(x,18) ^ ROTR(x,41)
//   * sigma_0(x) = ROTR(x,1)  ^ ROTR(x,8)  ^ SHR(x,7)
//   * sigma_1(x) = ROTR(x,19) ^ ROTR(x,61) ^ SHR(x,6)
//   * IV = first 64 bits of fractional parts of sqrt(first 8 primes)
//   * K  = first 64 bits of fractional parts of cbrt(first 80 primes)
//
// Test vector: FIPS 180-4 §C.1, "abc" message (single 1024-bit block).

module SHA512Compress where

// ---------- types ------------------------------------------------------

type W = [64]

// ---------- constants --------------------------------------------------

// FIPS 180-4 §5.3.5 — initial hash value H(0) for SHA-512.
sha512_iv : [8]W
sha512_iv =
    [ 0x6a09e667f3bcc908, 0xbb67ae8584caa73b
    , 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1
    , 0x510e527fade682d1, 0x9b05688c2b3e6c1f
    , 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
    ]

// FIPS 180-4 §4.2.3 — first 64 bits of the fractional parts of the
// cube roots of the first 80 primes. Order matters.
sha512_k : [80]W
sha512_k =
    [ 0x428a2f98d728ae22, 0x7137449123ef65cd
    , 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc
    , 0x3956c25bf348b538, 0x59f111f1b605d019
    , 0x923f82a4af194f9b, 0xab1c5ed5da6d8118
    , 0xd807aa98a3030242, 0x12835b0145706fbe
    , 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2
    , 0x72be5d74f27b896f, 0x80deb1fe3b1696b1
    , 0x9bdc06a725c71235, 0xc19bf174cf692694
    , 0xe49b69c19ef14ad2, 0xefbe4786384f25e3
    , 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65
    , 0x2de92c6f592b0275, 0x4a7484aa6ea6e483
    , 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5
    , 0x983e5152ee66dfab, 0xa831c66d2db43210
    , 0xb00327c898fb213f, 0xbf597fc7beef0ee4
    , 0xc6e00bf33da88fc2, 0xd5a79147930aa725
    , 0x06ca6351e003826f, 0x142929670a0e6e70
    , 0x27b70a8546d22ffc, 0x2e1b21385c26c926
    , 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df
    , 0x650a73548baf63de, 0x766a0abb3c77b2a8
    , 0x81c2c92e47edaee6, 0x92722c851482353b
    , 0xa2bfe8a14cf10364, 0xa81a664bbc423001
    , 0xc24b8b70d0f89791, 0xc76c51a30654be30
    , 0xd192e819d6ef5218, 0xd69906245565a910
    , 0xf40e35855771202a, 0x106aa07032bbd1b8
    , 0x19a4c116b8d2d0c8, 0x1e376c085141ab53
    , 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8
    , 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb
    , 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3
    , 0x748f82ee5defb2fc, 0x78a5636f43172f60
    , 0x84c87814a1f0ab72, 0x8cc702081a6439ec
    , 0x90befffa23631e28, 0xa4506cebde82bde9
    , 0xbef9a3f7b2c67915, 0xc67178f2e372532b
    , 0xca273eceea26619c, 0xd186b8c721c0c207
    , 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178
    , 0x06f067aa72176fba, 0x0a637dc5a2c898a6
    , 0x113f9804bef90dae, 0x1b710b35131c471b
    , 0x28db77f523047d84, 0x32caab7b40c72493
    , 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c
    , 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a
    , 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
    ]

// ---------- bit/word ops -----------------------------------------------

// Rotate-right and shift-right on 64-bit words. Cryptol's >> on a fixed-
// width sequence is logical (zero-fill). ROTR uses the standard
// "two halves OR'd" identity, generalised to 64 bits.
ROTR : [7] -> W -> W
ROTR n x = (x >> n) || (x << (64 - n))

SHR : [7] -> W -> W
SHR n x = x >> n

// FIPS 180-4 §4.1.3 — the six logical functions for SHA-512.
ch : W -> W -> W -> W
ch x y z = (x && y) ^ (~x && z)

maj : W -> W -> W -> W
maj x y z = (x && y) ^ (x && z) ^ (y && z)

big_sigma_0 : W -> W
big_sigma_0 x = (ROTR 28 x) ^ (ROTR 34 x) ^ (ROTR 39 x)

big_sigma_1 : W -> W
big_sigma_1 x = (ROTR 14 x) ^ (ROTR 18 x) ^ (ROTR 41 x)

small_sigma_0 : W -> W
small_sigma_0 x = (ROTR 1  x) ^ (ROTR 8  x) ^ (SHR 7  x)

small_sigma_1 : W -> W
small_sigma_1 x = (ROTR 19 x) ^ (ROTR 61 x) ^ (SHR 6  x)

// ---------- message schedule ------------------------------------------

// FIPS 180-4 §6.4.2 step 1:
//   W[t] = M[t]                                             for t in 0..15
//   W[t] = sigma1(W[t-2]) + W[t-7] + sigma0(W[t-15]) + W[t-16]
//                                                            for t in 16..79
schedule : [16]W -> [80]W
schedule M = sched
  where
    sched : [80]W
    sched = [ if t < 16
              then M @ t
              else (small_sigma_1 (sched @ (t - 2)))
                 + (sched @ (t - 7))
                 + (small_sigma_0 (sched @ (t - 15)))
                 + (sched @ (t - 16))
            | t <- [0..79] : [80][7] ]

// ---------- one round step --------------------------------------------

// FIPS 180-4 §6.4.2 step 3 (one iteration):
//   T1 = h + Sigma1(e) + Ch(e,f,g) + K[t] + W[t]
//   T2 = Sigma0(a) + Maj(a,b,c)
//   h = g; g = f; f = e; e = d + T1; d = c; c = b; b = a; a = T1 + T2
round_step : [8]W -> W -> W -> [8]W
round_step state w_t k_t =
    [ t1 + t2     // a' = T1 + T2
    , state @ 0   // b' = a
    , state @ 1   // c' = b
    , state @ 2   // d' = c
    , state @ 3 + t1   // e' = d + T1
    , state @ 4   // f' = e
    , state @ 5   // g' = f
    , state @ 6   // h' = g
    ]
  where
    a = state @ 0
    b = state @ 1
    c = state @ 2
    e = state @ 4
    f = state @ 5
    g = state @ 6
    h = state @ 7
    t1 = h + (big_sigma_1 e) + (ch e f g) + k_t + w_t
    t2 = (big_sigma_0 a) + (maj a b c)

// ---------- single-block compress -------------------------------------

// FIPS 180-4 §6.4.2 — compress a single 16-word (1024-bit) message block
// under the current 8-word hash state, returning the updated 8-word state.
compress : [8]W -> [16]W -> [8]W
compress h_in m = [ h_in @ i + final @ i | i <- [0..7] : [8][3] ]
  where
    w : [80]W
    w = schedule m

    states : [81][8]W
    states = [h_in] # [ round_step s w_t k_t
                      | s   <- states
                      | w_t <- w
                      | k_t <- sha512_k
                      ]

    final : [8]W
    final = states @ (80 : [7])

// ---------- KAT vectors (FIPS 180-4 §C.1: "abc") ----------------------

// "abc" (24 bits) padded to 128 bytes per FIPS 180-4 §5.1.2:
//   "abc" + 0x80 + (111 zero bytes) + 16-byte BE length 0x18
// As 16 big-endian 64-bit words.
abc_block_words : [16]W
abc_block_words =
    [ 0x6162638000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000018
    ]

// SHA-512("abc") — the post-compress state from the FIPS IV equals the
// canonical SHA-512 digest, by definition (single-block message).
abc_digest_words : [8]W
abc_digest_words =
    [ 0xddaf35a193617aba, 0xcc417349ae204131
    , 0x12e6fa4e89a97ea2, 0x0a9eeee64b55d39a
    , 0x2192992a274fc1a8, 0x36ba3c23a3feebbd
    , 0x454d4423643ce80e, 0x2a9ac94fa54ca49f
    ]

// Empty-string single-block padded message ("" → 0x80 then 0 then length=0).
empty_block_words : [16]W
empty_block_words =
    [ 0x8000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    , 0x0000000000000000, 0x0000000000000000
    ]

// SHA-512("") expected digest (canonical).
empty_digest_words : [8]W
empty_digest_words =
    [ 0xcf83e1357eefb8bd, 0xf1542850d66d8007
    , 0xd620e4050b5715dc, 0x83f4a921d36ce9ce
    , 0x47d0d13c5d85f2b0, 0xff8318d2877eec2f
    , 0x63b931bd47417a81, 0xa538327af927da3e
    ]

// ---------- properties -------------------------------------------------

// FIPS 180-4 §4.2.3 — spot checks of the K table against the published
// constants. Cheap to discharge; catches transcription bugs.
k_first    = sha512_k @  0 == 0x428a2f98d728ae22
k_eight    = sha512_k @  8 == 0xd807aa98a3030242
k_sixteen  = sha512_k @ 16 == 0xe49b69c19ef14ad2
k_thirtytwo= sha512_k @ 32 == 0x27b70a8546d22ffc
k_sixtyfour= sha512_k @ 64 == 0xca273eceea26619c
k_last     = sha512_k @ 79 == 0x6c44198c4a475817

// FIPS 180-4 §C.1 — full round-by-round transform. SAW symbolically
// reduces compress on the concrete inputs and discharges via z3.
abc_kat : Bit
abc_kat = compress sha512_iv abc_block_words == abc_digest_words

// SHA-512("") canonical digest — orthogonal vector that exercises the
// length=0 length-encoding edge case at words 14..15.
empty_kat : Bit
empty_kat = compress sha512_iv empty_block_words == empty_digest_words

// Algebraic sanity: ROTR n is inverse of itself rotated by 64-n.
rotr_inverse : [7] -> W -> Bit
rotr_inverse n x =
    n != 0 ==> n != 64 ==>
        ROTR (64 - n) (ROTR n x) == x

// Algebraic sanity: ch(x, y, z) when x is all-ones gives y; when x is
// all-zeros gives z. (Mirror of the FIPS pseudocode "if x then y else z".)
ch_all_ones  : W -> W -> Bit
ch_all_ones  y z = ch (~zero) y z == y

ch_all_zeros : W -> W -> Bit
ch_all_zeros y z = ch zero    y z == z

// Algebraic sanity: maj is symmetric in its first two arguments.
maj_symmetric_xy : W -> W -> W -> Bit
maj_symmetric_xy x y z = maj x y z == maj y x z

// Algebraic sanity: maj(x, x, x) == x (idempotent on equal inputs).
maj_idempotent : W -> Bit
maj_idempotent x = maj x x x == x
