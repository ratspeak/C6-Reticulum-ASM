// proofs/crypto/sha512/sha512_compress.saw
//
// SAW driver for sha512_compress algorithmic verification (Tier A per
// ADR-0009). Proves three orthogonal properties of the Cryptol model in
// SHA512Compress.cry:
//
//   1. K-table spot checks against FIPS 180-4 §4.2.3 — catches any
//      transcription bug in the 80 round constants (6 boundary samples).
//   2. FIPS 180-4 §C.1 ("abc") full compression result — symbolically
//      evaluates 80 rounds + 16-word schedule + 64 schedule recurrences
//      under the FIPS IV, must equal the canonical SHA-512("abc")
//      digest. Single-block edge.
//   3. Empty-string compression (length-encoding edge case at words 14..15)
//      — must equal the canonical SHA-512("") digest.
//
// Plus algebraic sanity over symbolic inputs:
//
//   4. ROTR is its own inverse (rotation of complementary distance).
//   5. ch(0xff..ff, y, z) == y and ch(0, y, z) == z (matches the FIPS
//      pseudocode "if x then y else z" interpretation).
//   6. maj is symmetric in (x, y) and idempotent on equal inputs.
//
// The binary-equivalence claim (the RV32 ELF computes this Cryptol model
// on every 16-word input from every 8-word state) is discharged
// separately by tests/crypto/sha512/test_sha512_kat.py via QEMU concrete
// cross-checking against a hashlib oracle on multiple test vectors.
// Until the macaw-riscv path described in ADR-0009 §"Tier C path forward"
// lands, Tier C remains bounded QEMU exploration rather than full SAW
// equivalence.

import "SHA512Compress.cry";

print "[sha512_compress.saw] checking K-table boundary constants ...";
prove_print z3 {{ k_first }};
prove_print z3 {{ k_eight }};
prove_print z3 {{ k_sixteen }};
prove_print z3 {{ k_thirtytwo }};
prove_print z3 {{ k_sixtyfour }};
prove_print z3 {{ k_last }};
print "[sha512_compress.saw] K-table boundary constants match FIPS 180-4 §4.2.3.";

print "[sha512_compress.saw] proving FIPS 180-4 §C.1 (abc) single-block KAT ...";
prove_print z3 {{ abc_kat }};
print "[sha512_compress.saw] FIPS C.1 KAT: PASS (compress(IV, M_abc) == SHA-512(\"abc\") digest).";

print "[sha512_compress.saw] proving canonical SHA-512(\"\") single-block KAT ...";
prove_print z3 {{ empty_kat }};
print "[sha512_compress.saw] empty-string KAT: PASS.";

print "[sha512_compress.saw] proving algebraic sanity (ROTR self-inverse) ...";
prove_print (do { unfolding ["ROTR"]; w4_unint_z3 []; })
            {{ \(x : [64]) -> rotr_inverse 14 x }};
prove_print (do { unfolding ["ROTR"]; w4_unint_z3 []; })
            {{ \(x : [64]) -> rotr_inverse 28 x }};
prove_print (do { unfolding ["ROTR"]; w4_unint_z3 []; })
            {{ \(x : [64]) -> rotr_inverse 39 x }};
prove_print (do { unfolding ["ROTR"]; w4_unint_z3 []; })
            {{ \(x : [64]) -> rotr_inverse 41 x }};
print "[sha512_compress.saw] ROTR self-inverse: PASS for n in {14,28,39,41}.";

print "[sha512_compress.saw] proving algebraic sanity (ch / maj) ...";
prove_print z3 {{ \(y : [64]) (z : [64]) -> ch_all_ones  y z }};
prove_print z3 {{ \(y : [64]) (z : [64]) -> ch_all_zeros y z }};
prove_print z3 {{ \(x : [64]) (y : [64]) (z : [64]) -> maj_symmetric_xy x y z }};
prove_print z3 {{ \(x : [64]) -> maj_idempotent x }};
print "[sha512_compress.saw] ch + maj algebraic properties: PASS.";

print "[sha512_compress.saw] PASS";
