// proofs/crypto/sha512/sha512_init.saw
//
// SAW driver for sha512_init algorithmic verification (Tier A per
// ADR-0009): proves the Cryptol model in SHA512Init.cry is algebraically
// consistent with FIPS 180-4 §5.3.5 and that its byte-serialization is a
// well-formed bijection.
//
// Tier A is intentionally narrow at this stage: we are verifying that
// the *spec* matches the standard. The binary-equivalence claim (the
// RV32 ELF computes the spec's post-state on every execution) is
// discharged by the QEMU pytest at tests/crypto/sha512/test_sha512_kat.py
// — not here. SAW will gain the ability to verify our RV32 binary
// directly once the macaw-riscv integration described in
// ADR-0009 §"Tier C path forward" lands.
//
// Run standalone:
//   saw proofs/crypto/sha512/sha512_init.saw
// or via dispatcher:
//   ./verify sha512_init

import "SHA512Init.cry";

print "[sha512_init.saw] proving FIPS 180-4 §5.3.5 IV constants ...";
prove_print z3 {{ iv_word_0 }};
prove_print z3 {{ iv_word_1 }};
prove_print z3 {{ iv_word_2 }};
prove_print z3 {{ iv_word_3 }};
prove_print z3 {{ iv_word_4 }};
prove_print z3 {{ iv_word_5 }};
prove_print z3 {{ iv_word_6 }};
prove_print z3 {{ iv_word_7 }};
print "[sha512_init.saw] all 8 IV words match FIPS 180-4 §5.3.5.";

print "[sha512_init.saw] proving little-endian byte serialization ...";
prove_print z3 {{ h_bytes_le_word0_lsb }};
prove_print z3 {{ h_bytes_le_word0_msb }};
prove_print z3 {{ h_bytes_le_word7_lsb }};
prove_print z3 {{ h_bytes_le_word7_msb }};
print "[sha512_init.saw] LE byte order spot-checks pass.";

print "[sha512_init.saw] proving RV32 (lo32, hi32) decomposition ...";
prove_print z3 {{ iv0_lo }};
prove_print z3 {{ iv0_hi }};
prove_print z3 {{ iv7_lo }};
prove_print z3 {{ iv7_hi }};
print "[sha512_init.saw] RV32 word-pair layout matches asm rodata.";

print "[sha512_init.saw] proving counter fields are zero ...";
prove_print z3 {{ lenbits_zero }};
prove_print z3 {{ blocklen_zero }};
print "[sha512_init.saw] counter fields zero.";

print "[sha512_init.saw] proving qword_to_le_bytes is a bijection on [64] ...";
prove_print z3 {{ \(w : [64]) -> qword_to_le_roundtrip w }};
print "[sha512_init.saw] bijection holds for all 2^64 inputs.";

print "[sha512_init.saw] PASS";
