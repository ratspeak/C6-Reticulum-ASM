// proofs/crypto/sha512/SHA512Init.cry
//
// Cryptol algorithmic specification for sha512_init.
//
// FIPS 180-4 §5.3.5 fixes the SHA-512 initial hash value H(0) — eight
// 64-bit words derived from the fractional parts of the square roots of
// the first eight primes. The init function's only job is to install
// these constants into ctx->H[0..7] and zero the running counters
// (length_bits, block_len). The partial-block buffer (ctx->block) is
// left undefined: sha512_update only reads bytes it has previously
// written.
//
// On RV32 the asm stores each 64-bit IV as a (lo32, hi32) pair in
// little-endian order — that's what the binary-equivalence verifier
// (when it eventually targets the ELF) checks. SAW discharges the
// algebraic properties below via z3 in milliseconds.

module SHA512Init where

// FIPS 180-4 §5.3.5 — initial hash value H(0).
sha512_iv : [8][64]
sha512_iv =
    [ 0x6a09e667f3bcc908
    , 0xbb67ae8584caa73b
    , 0x3c6ef372fe94f82b
    , 0xa54ff53a5f1d36f1
    , 0x510e527fade682d1
    , 0x9b05688c2b3e6c1f
    , 0x1f83d9abfb41bd6b
    , 0x5be0cd19137e2179
    ]

// Serialise one 64-bit word into 8 little-endian bytes.
//
//   qword_to_le_bytes 0x6a09e667f3bcc908
//     == [0x08, 0xc9, 0xbc, 0xf3, 0x67, 0xe6, 0x09, 0x6a]
//
// Cryptol's `split` is big-endian (MSB first); reversing yields LE.
qword_to_le_bytes : [64] -> [8][8]
qword_to_le_bytes w = reverse (split w)

// The 64-byte H region as it appears in memory after sha512_init.
h_bytes_le : [64][8]
h_bytes_le = join [ qword_to_le_bytes w | w <- sha512_iv ]

// length_bits field — 8 zero bytes at ctx + 64.
lenbits_bytes_zero : [8][8]
lenbits_bytes_zero = zero

// block_len field — 4 zero bytes at ctx + 200.
blocklen_bytes_zero : [4][8]
blocklen_bytes_zero = zero

// On RV32, each 64-bit IV is stored as a (lo32, hi32) pair. Verify the
// canonical decomposition matches expectations.
qword_to_le_lo : [64] -> [32]
qword_to_le_lo w = drop`{32} w

qword_to_le_hi : [64] -> [32]
qword_to_le_hi w = take`{32} w

// Algebraic properties (Bit-valued; SAW discharges with `prove_print z3 {{ p }}`).

iv_word_0 = sha512_iv @ 0 == 0x6a09e667f3bcc908
iv_word_1 = sha512_iv @ 1 == 0xbb67ae8584caa73b
iv_word_2 = sha512_iv @ 2 == 0x3c6ef372fe94f82b
iv_word_3 = sha512_iv @ 3 == 0xa54ff53a5f1d36f1
iv_word_4 = sha512_iv @ 4 == 0x510e527fade682d1
iv_word_5 = sha512_iv @ 5 == 0x9b05688c2b3e6c1f
iv_word_6 = sha512_iv @ 6 == 0x1f83d9abfb41bd6b
iv_word_7 = sha512_iv @ 7 == 0x5be0cd19137e2179

// Little-endian serialisation has the LSB at offset 0 of each word.
h_bytes_le_word0_lsb = h_bytes_le @ 0  == 0x08
h_bytes_le_word0_msb = h_bytes_le @ 7  == 0x6a
h_bytes_le_word7_lsb = h_bytes_le @ 56 == 0x79
h_bytes_le_word7_msb = h_bytes_le @ 63 == 0x5b

// On RV32 the asm splits each 64-bit IV as (lo32, hi32). Spot-check
// the first and last IVs.
iv0_lo = qword_to_le_lo (sha512_iv @ 0) == 0xf3bcc908
iv0_hi = qword_to_le_hi (sha512_iv @ 0) == 0x6a09e667
iv7_lo = qword_to_le_lo (sha512_iv @ 7) == 0x137e2179
iv7_hi = qword_to_le_hi (sha512_iv @ 7) == 0x5be0cd19

// Zero fields really are zero.
lenbits_zero  = lenbits_bytes_zero == zero
blocklen_zero = blocklen_bytes_zero == zero

// qword_to_le_bytes is a bijection on its 8-byte image — round trip back
// to the original word reconstructs the input. Universally quantified
// over [64] (catches any byte-order confusion in the spec itself).
qword_to_le_roundtrip : [64] -> Bit
qword_to_le_roundtrip w = join (reverse (qword_to_le_bytes w)) == w
